# Copy this file to backend/.env (for local runs) or .env (for docker compose),
# then fill in your key. NEVER commit a real key.

# Fast cloud inference (recommended). Get a free key at https://console.groq.com
GROQ_API_KEY=

# Optional overrides:
# ELOQUENCE_PROVIDER=groq        # force provider: groq | ollama (auto-detects groq if key set)
# GROQ_MODEL=openai/gpt-oss-120b
# OLLAMA_HOST=http://localhost:11434   # local Ollama endpoint
